# Public app origin used for Stripe return URLs.
NEXT_PUBLIC_APP_URL=https://usagemax.com

# Convex site URL used by the Vercel webhook facade.
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Stripe server-side configuration. Never expose the secret or webhook secret
# to the browser, repository, CLI, or customer telemetry.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Create this recurring Stripe Price before enabling the Team checkout button.
STRIPE_TEAM_PRICE_ID=price_replace_me

# Shared only between Vercel and Convex; signs server-side customer linking.
BILLING_INTERNAL_SECRET=replace_with_a_long_random_secret
