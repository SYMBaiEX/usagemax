{
  "name": "@usagemax/web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && bun run --cwd packages/cli test",
    "cli:pack": "bun run --cwd packages/cli pack:check",
    "loadtest:ingest": "node scripts/load-test-ingest.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.4.0",
    "@workos-inc/authkit-nextjs": "^4.3.2",
    "@workos-inc/node": "^10.13.0",
    "convex": "^1.46.0",
    "facehash": "0.1.0",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/compat": "2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "convex-test": "^0.0.59",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
