{
  "name": "usagemax",
  "version": "0.3.10",
  "description": "Link local coding-agent usage to your UsageMax profile",
  "keywords": [
    "usagemax",
    "ai-usage",
    "usage-analytics",
    "coding-agents",
    "agent-usage",
    "telemetry",
    "observability",
    "usage",
    "ccusage",
    "claude-code",
    "codex",
    "privacy"
  ],
  "license": "MIT",
  "author": "UsageMax",
  "homepage": "https://usagemax.com",
  "bugs": {
    "url": "https://github.com/SYMBaiEX/usagemax/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYMBaiEX/usagemax.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "usagemax": "src/cli.js"
  },
  "files": [
    "src/archives.js",
    "src/cli.js",
    "src/core.js",
    "src/installation.js",
    "src/sources.js",
    "src/transport.js",
    "src/progress.js",
    "src/updates.js",
    "src/resume.js",
    "src/service.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test src/*.test.js",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "ccusage": "20.0.23"
  }
}
